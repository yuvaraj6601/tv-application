.env
.env.local
.env.*.local

# macOS
.DS_Store

# build outputs
dist/
build/
coverage/
**/.cache/
**/.turbo/

# frontend tooling
**/.vite/

# react native — android build artifacts
**/android/.gradle/
**/android/app/build/
**/android/app/.cxx/
**/android/build/
**/android/.idea/
**/android/**/*.iml
**/android/local.properties
