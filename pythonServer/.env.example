ENVIRONMENT=local
# Local/test: point at a local or staging MySQL instance
# Production: point at the shared central pythonServer MySQL DB
PI_ANALYTICS_DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/pythonServer

# Production: auto-detected via getmac at startup if left unset
# Local testing: fixed dev value so test data never collides with real Pi rows
PI_ID=local-dev-test

CAPTURE_INTERVAL_SECONDS=2
ABSENCE_TIMEOUT_SECONDS=30
# Cosine distance (1 - cosine similarity) between InsightFace (buffalo_s) embeddings.
# Lower = stricter match (more likely to double-count the same person as a new visitor).
# Higher = looser match (more tolerant of angle/lighting variation between sightings).
# 2026-08-06: tuned 0.5 -> 0.6 -> 0.7 during real-webcam testing (each still too strict, causing
# duplicate visitors), then explicitly set down to 0.4, then further down to 0.2 per direct
# request — both confirmed knowingly against the direction of the prior tuning (stricter, not
# looser).
# 2026-08-18: raised back up to 0.55 after camera-resolution increase still left a high duplicate
# rate — root cause was the overly strict 0.2 threshold rejecting real re-sightings of the same
# visitor as new people, worsened by visitors standing 50-100cm+ from the camera (lower face
# detail at that distance -> noisier embeddings -> higher same-person distance). 0.55 sits at the
# upper end of the 0.4-0.6 range confirmed as the target for this embedding model.
FACE_MATCH_DISTANCE_THRESHOLD=0.55

# Requested camera capture resolution (pixels). Higher resolution improves face embedding
# quality, which reduces the same person being mistakenly registered as multiple visitors.
# Falls back silently to the camera's native resolution if the device doesn't support these.
CAMERA_FRAME_WIDTH=1280
CAMERA_FRAME_HEIGHT=720

DATA_DIR=data
ROTATION_CHECK_INTERVAL_SECONDS=3600
SYNC_INTERVAL_SECONDS=300
