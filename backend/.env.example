PORT=8080
JWT_ACCESS_SECRET=replace-with-strong-secret
SOCKET_CORS_ORIGIN=http://localhost:5173
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-me
DEVICE_OFFLINE_THRESHOLD_MS=120000
DEVICE_STATUS_RECONCILE_INTERVAL_MS=30000
STORAGE_PROVIDER=r2
STORAGE_BUCKET=your-bucket
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
DATABASE_URL=mysql://user:password@localhost:3306/tv-application
# Read-only: points at the pythonServer's MySQL DB (migrations owned by pythonServer/alembic)
PI_ANALYTICS_DATABASE_URL=mysql://user:password@localhost:3306/tv-application-analytics
