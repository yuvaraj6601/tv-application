generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DeviceStatus {
  ONLINE
  OFFLINE
}

enum ContentType {
  IMAGE
  VIDEO
  WEBPAGE
}

enum DeviceOrientation {
  PORTRAIT
  LANDSCAPE
  PORTRAIT_FLIP
  LANDSCAPE_FLIP
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  devices      Device[]
  contents     Content[]
}

model Device {
  id             String            @id @default(cuid())
  deviceName     String
  deviceUniqueId String            @unique
  macAddress     String?           @unique @db.VarChar(17)
  pairingCode    String?           @db.VarChar(4)
  isPaired       Boolean           @default(false)
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  token          String?           @unique @db.VarChar(512)
  lastSeen       DateTime?
  status         DeviceStatus      @default(OFFLINE)
  orientation    DeviceOrientation @default(PORTRAIT)
  piId           String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  playlists      PlaylistItem[]
  heartbeats     DeviceHeartbeat[]

  @@index([pairingCode])
  @@index([status, lastSeen])
}

model Content {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ContentType
  url          String
  localPath    String?
  fileName     String?
  fileMimeType String?
  duration     Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  playlistRef  PlaylistItem[]

  @@index([userId])
}

model PlaylistItem {
  id        String   @id @default(cuid())
  deviceId  String
  contentId String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([deviceId, order])
  @@unique([deviceId, contentId])
}

model DeviceHeartbeat {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  seenAt     DateTime @default(now())
  appVersion String?
  ipAddress  String?

  @@index([deviceId, seenAt])
}
